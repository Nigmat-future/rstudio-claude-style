diff --git a/e2e/rstudio/tests/panes/theme_hooks.test.ts b/e2e/rstudio/tests/panes/theme_hooks.test.ts
new file mode 100644
index 0000000..b5e79b9
--- /dev/null
+++ b/e2e/rstudio/tests/panes/theme_hooks.test.ts
@@ -0,0 +1,85 @@
+import { test, expect } from '@fixtures/rstudio.fixture';
+import { executeInConsole } from '@pages/console_pane.page';
+import { clearPref, getPref, setPref } from '@utils/commands';
+import {
+  ACE_THEME_LINK, DARK_THEME, DARK_THEME_HREF, LIGHT_THEME, LIGHT_THEME_HREF, expectThemeStylesheet,
+} from '@utils/theme';
+import type { Locator } from '@playwright/test';
+
+const STYLE_ID = 'rstudio-theme-hooks-test';
+const PREFS = ['editor_theme', 'show_terminal_tab', 'jobs_tab_visibility', 'show_launcher_jobs_tab'] as const;
+
+function appearance(target: Locator) {
+  return target.evaluate(element => {
+    const style = getComputedStyle(element);
+    const { x, y, width, height } = element.getBoundingClientRect();
+    return {
+      backgroundColor: style.backgroundColor,
+      color: style.color,
+      bounds: { x, y, width, height },
+    };
+  });
+}
+
+test('public theme hooks recolor real IDE chrome without changing its layout', async ({ rstudioPage: page }) => {
+  // Given a Console-only pane, whose primary title bar is attached to the DOM.
+  const savedPrefs = await Promise.all(PREFS.map(async name => ({ name, value: await getPref(page, name) })));
+  try {
+    await setPref(page, 'show_terminal_tab', false);
+    await setPref(page, 'jobs_tab_visibility', 'closed');
+    await setPref(page, 'show_launcher_jobs_tab', false);
+    await page.reload();
+    await page.waitForFunction(() => window.rstudio?.ready === true);
+
+    const consoleFrame = page.locator('.windowframe').filter({ has: page.locator('#rstudio_console_input') });
+    const title = consoleFrame.locator('.rstheme_windowFrameHeader .rstheme_primaryWindowFrameHeader');
+    const content = consoleFrame.locator('.rstheme_windowFrameContent').filter({ has: page.locator('#rstudio_console_input') });
+    const toolbar = page.locator('.rstheme_toolbarWrapper table.rstheme_toolbar:visible').first();
+    const targets = [title, toolbar] as const;
+
+    for (const [theme, href] of [[LIGHT_THEME, LIGHT_THEME_HREF], [DARK_THEME, DARK_THEME_HREF]] as const) {
+      await executeInConsole(page, `.rs.api.applyTheme(${JSON.stringify(theme)})`, { wait: true });
+      await expectThemeStylesheet(page, href);
+      await expect.poll(() => page.locator(ACE_THEME_LINK).evaluate(
+        element => element instanceof HTMLLinkElement && element.sheet !== null,
+      ), { timeout: 15000 }).toBe(true);
+      await expect(content).toBeVisible();
+      for (const target of targets)
+        await expect(target).toBeVisible();
+      const before = await Promise.all(targets.map(appearance));
+      for (const value of before)
+        expect(value.backgroundColor).not.toBe('rgb(17, 34, 51)');
+
+      // When a theme author overrides only colors through the public classes.
+      await page.evaluate(id => {
+        const style = document.createElement('style');
+        style.id = id;
+        style.textContent = `.rstheme_primaryWindowFrameHeader, .rstheme_toolbar {
+          background-color: rgb(17, 34, 51) !important;
+          color: rgb(221, 238, 255) !important;
+        }`;
+        document.head.append(style);
+      }, STYLE_ID);
+
+      // Then colors change, geometry stays fixed, and removing CSS restores both.
+      await expect.poll(() => Promise.all(targets.map(appearance))).toEqual(before.map(value => ({
+        ...value, backgroundColor: 'rgb(17, 34, 51)', color: 'rgb(221, 238, 255)',
+      })));
+      await page.locator(`#${STYLE_ID}`).evaluate(element => element.remove());
+      await expect.poll(() => Promise.all(targets.map(appearance))).toEqual(before);
+    }
+  } finally {
+    try {
+      await page.locator(`#${STYLE_ID}`).evaluateAll(elements => elements.forEach(element => element.remove()));
+    } finally {
+      for (const { name, value } of savedPrefs) {
+        if (value === null)
+          await clearPref(page, name);
+        else
+          await setPref(page, name, value);
+      }
+      await page.reload();
+      await page.waitForFunction(() => window.rstudio?.ready === true);
+    }
+  }
+});
